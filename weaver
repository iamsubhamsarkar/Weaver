#!/bin/bash
# ═══════════════════════════════════════════════════════════
#  WEAVER - One-command launcher
#  Just run: ./weaver
# ═══════════════════════════════════════════════════════════

set -e

# Resolve the real path even if called via symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    # If SOURCE is relative, resolve it relative to the symlink's directory
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

WEAVER_HOME="$HOME/.weaver"
CREDENTIALS_FILE="$WEAVER_HOME/credentials.yml"
JAR_FILE="$SCRIPT_DIR/target/weaver-agent-1.0.0-SNAPSHOT.jar"

# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
DIM='\033[2m'
RESET='\033[0m'

# ─── Step 1: Check Java ───────────────────────────────────
check_java() {
    if ! command -v java &> /dev/null; then
        echo -e "${RED}Java not found!${RESET}"
        echo ""
        if [[ "$OSTYPE" == "linux-gnu"* ]]; then
            echo "  Install with: sudo apt install openjdk-21-jdk"
        elif [[ "$OSTYPE" == "darwin"* ]]; then
            echo "  Install with: brew install openjdk@21"
        fi
        exit 1
    fi
}

# ─── Step 2: Build if needed ──────────────────────────────
build_if_needed() {
    if [ ! -f "$JAR_FILE" ]; then
        echo -e "${CYAN}Building Weaver (first time only)...${RESET}"
        
        if command -v mvn &> /dev/null; then
            cd "$SCRIPT_DIR"
            if ! mvn package -DskipTests -q 2>&1 | tail -5; then
                echo -e "${RED}Build failed. Running verbose build for details:${RESET}"
                mvn package -DskipTests 2>&1 | grep -E "ERROR|FAILURE" | head -10
            fi
        elif [ -f "$SCRIPT_DIR/mvnw" ]; then
            cd "$SCRIPT_DIR"
            if ! ./mvnw package -DskipTests -q 2>&1 | tail -5; then
                echo -e "${RED}Build failed.${RESET}"
            fi
        else
            echo -e "${RED}Maven not found!${RESET}"
            if [[ "$OSTYPE" == "linux-gnu"* ]]; then
                echo "  Install with: sudo apt install maven"
            elif [[ "$OSTYPE" == "darwin"* ]]; then
                echo "  Install with: brew install maven"
            fi
            exit 1
        fi

        if [ ! -f "$JAR_FILE" ]; then
            echo -e "${RED}Build failed. Run 'cd $SCRIPT_DIR && mvn package' to see full errors.${RESET}"
            exit 1
        fi
        echo -e "${GREEN}✓ Build complete${RESET}"
    fi
}

# ─── Step 3: Start ChromaDB if Docker available ───────────
start_chromadb() {
    if ! command -v docker &> /dev/null; then
        return  # Docker not installed — skip
    fi

    # Check if Docker daemon is running
    if ! docker info &> /dev/null 2>&1; then
        # Try to start Docker daemon (Linux)
        if [[ "$OSTYPE" == "linux-gnu"* ]]; then
            sudo systemctl start docker 2>/dev/null
            sleep 2
            if ! docker info &> /dev/null 2>&1; then
                return  # Still can't start Docker
            fi
        else
            return  # macOS — user needs to start Docker Desktop
        fi
    fi

    # Check if ChromaDB container is running
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "weaver-chroma"; then
        return  # Already running
    fi

    # Try to start existing container, or create a new one
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q "weaver-chroma"; then
        docker start weaver-chroma &> /dev/null
    else
        docker run -d --name weaver-chroma --restart unless-stopped \
            -p 8000:8000 chromadb/chroma:0.5.23 &> /dev/null
    fi

    # Wait for ChromaDB to be ready
    for i in 1 2 3 4 5; do
        if curl -s --connect-timeout 1 http://localhost:8000/api/v1/heartbeat &> /dev/null; then
            echo -e "${DIM}  ChromaDB: ready (semantic cache active)${RESET}"
            return
        fi
        sleep 1
    done
    echo -e "${DIM}  ChromaDB: starting (may take a moment)${RESET}"
}

# ─── Step 4: Start Ollama if not running ──────────────────
start_ollama() {
    if ! command -v ollama &> /dev/null; then
        return  # Ollama not installed — skip silently
    fi

    # Check if Ollama is already serving on port 11434
    if curl -s --connect-timeout 1 http://localhost:11434/api/tags &> /dev/null; then
        return  # Already running
    fi

    # Start Ollama in the background
    echo -e "${DIM}  Ollama: starting local brain...${RESET}"
    ollama serve &> /dev/null &
    OLLAMA_PID=$!

    # Wait up to 5 seconds for it to become ready
    for i in 1 2 3 4 5; do
        if curl -s --connect-timeout 1 http://localhost:11434/api/tags &> /dev/null; then
            echo -e "${DIM}  Ollama: ready (Qwen2 local brain active)${RESET}"
            return
        fi
        sleep 1
    done
    echo -e "${DIM}  Ollama: started (may need a moment to load model)${RESET}"
}

# ─── Step 5: Load credentials as env vars ─────────────────
load_credentials() {
    if [ ! -f "$CREDENTIALS_FILE" ]; then
        return
    fi

    # Parse the simple YAML structure and export as env vars
    # Format: provider:\n  api-key: VALUE
    local current_provider=""
    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "$line" =~ ^#.*$ ]] && continue
        [[ -z "$line" ]] && continue

        # Provider line (no leading whitespace, ends with :)
        if [[ "$line" =~ ^([a-z]+):$ ]]; then
            current_provider="${BASH_REMATCH[1]}"
        # Key line (has leading whitespace)
        elif [[ "$line" =~ ^[[:space:]]+api-key:[[:space:]]*(.+)$ ]]; then
            local key_value="${BASH_REMATCH[1]}"
            if [ -n "$current_provider" ] && [ -n "$key_value" ] && [[ "$key_value" != YOUR_* ]]; then
                local env_var="${current_provider^^}_API_KEY"
                export "$env_var"="$key_value"
            fi
        fi
    done < "$CREDENTIALS_FILE"
}

# ─── Step 6: Launch ───────────────────────────────────────
launch() {
    # Pass the user's actual working directory (where they typed 'weaver')
    # to the JVM so the agent operates on the correct project
    USER_PWD="${WEAVER_USER_PWD:-$(pwd)}"
    exec java -Dweaver.workspace="$USER_PWD" -jar "$JAR_FILE" --spring.profiles.active=local "$@"
}

# ═══════════════════════════════════════════════════════════
#  Main
# ═══════════════════════════════════════════════════════════

# Capture the user's working directory BEFORE we cd anywhere
export WEAVER_USER_PWD="$(pwd)"

check_java
build_if_needed
start_chromadb
start_ollama
load_credentials
launch "$@"
