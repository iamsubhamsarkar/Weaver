<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      Weaver Logging Configuration:
      - Session log: saved in the directory where weaver is called from (weaver-session.log)
      - Captures EVERYTHING: user input, agent decisions, API calls, errors, tool results
      - Console shows NOTHING (clean UX)
    -->

    <!-- Session log in the user's working directory (passed via -Dweaver.workspace) -->
    <property name="SESSION_LOG" value="${weaver.workspace:-.}/weaver-session.log"/>

    <!-- Session file appender - captures ALL activity -->
    <appender name="SESSION" class="ch.qos.logback.core.FileAppender">
        <file>${SESSION_LOG}</file>
        <append>false</append>  <!-- Fresh log each time weaver starts -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%-5level] %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Log EVERYTHING for debugging -->
    <logger name="dev.langchain4j" level="DEBUG"/>
    <logger name="dev.ai4j" level="DEBUG"/>
    <logger name="com.weaver" level="DEBUG"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.apache" level="WARN"/>

    <!-- Root: everything to session file -->
    <root level="DEBUG">
        <appender-ref ref="SESSION"/>
    </root>
</configuration>
