<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      Weaver Logging Configuration:
      - Session log: APPENDS to weaver-session.log in user's working directory
      - NEVER overwrites old logs — continuous across sessions
      - Captures EVERYTHING: inputs, decisions, API calls, errors, tool results
    -->

    <!-- Session log in the user's working directory -->
    <property name="SESSION_LOG" value="${weaver.workspace:-.}/weaver-session.log"/>

    <!-- Session file appender - APPEND mode (never deletes old logs) -->
    <appender name="SESSION" class="ch.qos.logback.core.FileAppender">
        <file>${SESSION_LOG}</file>
        <append>true</append>  <!-- ALWAYS APPEND - never overwrite -->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Log EVERYTHING for debugging -->
    <logger name="dev.langchain4j" level="DEBUG"/>
    <logger name="dev.ai4j" level="DEBUG"/>
    <logger name="com.weaver" level="DEBUG"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.apache" level="WARN"/>

    <!-- Root: everything to session file -->
    <root level="DEBUG">
        <appender-ref ref="SESSION"/>
    </root>
</configuration>
